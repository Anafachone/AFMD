{
  "manifest_version": 3,
  "name": "AFMD Transcrições",
  "version": "0.2.0",
  "description": "Painel AFMD com histórico, clientes, etiquetas e captura experimental de legendas do Meet.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AFMD Transcrições — abrir controles"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "captions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}